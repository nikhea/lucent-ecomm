PAYLOAD_SECRET=replace-with-32plus-random-hex-use-openssl-rand-hex-32
# For prod: openssl rand -hex 32
DATABASE_URL=mongodb://127.0.0.1/template-ecommerce
# For prod: mongodb+srv://user:pass@cluster.mongodb.net/lucent?retryWrites=true&w=majority (requires replica set for transactions)

COMPANY_NAME="Payload Inc."
TWITTER_CREATOR="@payloadcms"
TWITTER_SITE="https://nextjs.org/commerce"
SITE_NAME="Payload Commerce"

PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
# In prod: https://yourdomain.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# In prod: https://yourdomain.com - must match PAYLOAD_PUBLIC_SERVER_URL for SEO, Stripe webhooks, Cloudinary URLs, email links

# Used to preview drafts
PREVIEW_SECRET=demo-draft-secret

# Stripe API keys
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOKS_SIGNING_SECRET=whsec_

# Email - use secrets vault in prod (not .env). For Gmail, create App Password at https://myaccount.google.com/apppasswords
# For prod prefer Resend/SendGrid: set EMAIL_SERVICE and app password, never commit real values
EMAIL_ADDRESS=
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_SERVICE=Gmail
# Alternative (Resend): EMAIL_SERVICE=resend, EMAIL_PASSWORD=re_xxx

# Abandoned cart sweep - bearer secret for POST /api/abandoned-cart/sweep
ABANDONED_CART_SECRET=dev-abandoned-cart-secret-change-me
STOCK_RESERVATION_SECRET=dev-stock-reservation-secret-change-me
SALES_REPORTS_TIMEZONE=America/New_York

# Cloudinary (payload file storage) - set CLOUDINARY_URL or individual vars
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
CLOUDINARY_FOLDER=lucent
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
